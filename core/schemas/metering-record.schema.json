{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoduksini:schema:metering-record:1",
  "title": "Eoduksini local Controller metering record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "task_id", "root_task_id", "attempt_id", "parent_attempt_id", "retry_index",
    "node_id", "boot_id", "routing_decision", "worker_started_at_utc", "worker_finished_at_utc",
    "monotonic_started_ns", "monotonic_finished_ns", "execution_duration_ms", "worker_cpu_user_seconds",
    "worker_cpu_system_seconds", "worker_memory_peak_bytes", "measurement_scope", "measurement_method",
    "measurement_completeness", "missing_reasons", "execution_status", "test_status", "review_status",
    "integration_status", "adoption_status", "model_input_tokens", "model_output_tokens", "model_usage_status",
    "model_usage_missing_reason", "estimated_api_avoided_cost", "estimated_api_avoided_currency", "api_cost_status",
    "api_cost_missing_reason", "energy_kwh", "energy_cost", "energy_currency", "energy_status",
    "energy_missing_reason", "result_digest", "invocations", "command_measurements"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "root_task_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "parent_attempt_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "retry_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "node_id": {"$ref": "#/$defs/nodeId"},
    "boot_id": {"anyOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]},
    "routing_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["reason_code", "chosen_provider_kind", "decision_source", "decided_at"],
      "properties": {
        "reason_code": {"enum": ["LOCAL_COST_POLICY", "CLOUD_UNAVAILABLE", "PRIVACY_RESTRICTED", "PRESERVE_SUBSCRIPTION_CAPACITY", "VERIFIED_LOCAL_CAPABILITY", "DETERMINISTIC_TOOL_PREFERRED", "USER_PINNED", "PILOT_EXPERIMENT", "RESOURCE_AVAILABLE"]},
        "chosen_provider_kind": {"$ref": "#/$defs/id"},
        "decision_source": {"$ref": "#/$defs/id"},
        "decided_at": {"$ref": "#/$defs/time"}
      }
    },
    "worker_started_at_utc": {"$ref": "#/$defs/nullableTime"},
    "worker_finished_at_utc": {"$ref": "#/$defs/nullableTime"},
    "monotonic_started_ns": {"$ref": "#/$defs/nullableIntegerString"},
    "monotonic_finished_ns": {"$ref": "#/$defs/nullableIntegerString"},
    "execution_duration_ms": {"$ref": "#/$defs/nullableNumber"},
    "worker_cpu_user_seconds": {"$ref": "#/$defs/nullableNumber"},
    "worker_cpu_system_seconds": {"$ref": "#/$defs/nullableNumber"},
    "worker_memory_peak_bytes": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "measurement_scope": {"enum": ["DIRECT_CHILD", "DIRECT_CHILD_TREE", "MIXED"]},
    "measurement_method": {"enum": ["RUNNER_LIFECYCLE_ONLY", "GNU_TIME_V1", "MIXED"]},
    "measurement_completeness": {"enum": ["PARTIAL", "COMPLETE"]},
    "missing_reasons": {"$ref": "#/$defs/stringSet"},
    "execution_status": {"enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "LOST"]},
    "test_status": {"enum": ["NOT_RUN", "PASS", "FAIL", "INCOMPLETE"]},
    "review_status": {"enum": ["PENDING", "PASS", "NEEDS_FIX", "REJECTED", "BLOCKED"]},
    "integration_status": {"const": "NOT_SUBMITTED"},
    "adoption_status": {"enum": ["PENDING", "ADOPTED", "PARTIALLY_ADOPTED", "REJECTED", "REVERTED"]},
    "model_input_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "model_output_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "model_usage_status": {"enum": ["NOT_APPLICABLE", "MISSING", "OBSERVED"]},
    "model_usage_missing_reason": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
    "estimated_api_avoided_cost": {"$ref": "#/$defs/nullableNumber"},
    "estimated_api_avoided_currency": {"anyOf": [{"type": "string", "pattern": "^[A-Z]{3}$"}, {"type": "null"}]},
    "api_cost_status": {"enum": ["INCOMPLETE", "NOT_COMPARABLE", "ESTIMATED"]},
    "api_cost_missing_reason": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
    "energy_kwh": {"$ref": "#/$defs/nullableNumber"},
    "energy_cost": {"$ref": "#/$defs/nullableNumber"},
    "energy_currency": {"anyOf": [{"type": "string", "pattern": "^[A-Z]{3}$"}, {"type": "null"}]},
    "energy_status": {"enum": ["INCOMPLETE", "OBSERVED", "ESTIMATED"]},
    "energy_missing_reason": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
    "result_digest": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "invocations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/invocation"}},
    "command_measurements": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/commandMeasurement"}},
    "review_events": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/reviewEvent"}},
    "adoption_events": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/adoptionEvent"}},
    "cost_events": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/costEvent"}},
    "energy_events": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/energyEvent"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "nodeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f]+$"},
    "time": {"type": "string", "format": "date-time", "maxLength": 32},
    "nullableTime": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "nullableIntegerString": {"anyOf": [{"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 32}, {"type": "null"}]},
    "nullableNumber": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "stringSet": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["invocation_id", "provider_kind", "provider_endpoint_ref", "inference_node_id", "model_name",
        "model_digest_or_revision", "inference_location", "prompt_eval_count", "eval_count",
        "total_duration_ns", "load_duration_ns", "prompt_eval_duration_ns", "eval_duration_ns", "response_complete",
        "usage_status", "usage_missing_reason"],
      "properties": {
        "invocation_id": {"$ref": "#/$defs/id"},
        "provider_kind": {"$ref": "#/$defs/id"},
        "provider_endpoint_ref": {"$ref": "#/$defs/id"},
        "inference_node_id": {"$ref": "#/$defs/nodeId"},
        "model_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_digest_or_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "inference_location": {"enum": ["LOCAL", "REMOTE_PRIVATE", "CLOUD", "UNKNOWN"]},
        "prompt_eval_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "eval_count": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "total_duration_ns": {"$ref": "#/$defs/nullableIntegerString"},
        "load_duration_ns": {"$ref": "#/$defs/nullableIntegerString"},
        "prompt_eval_duration_ns": {"$ref": "#/$defs/nullableIntegerString"},
        "eval_duration_ns": {"$ref": "#/$defs/nullableIntegerString"},
        "response_complete": {"type": "boolean"},
        "usage_status": {"enum": ["OBSERVED", "MISSING"]},
        "usage_missing_reason": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]}
      }
    },
    "reviewEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "attempt_id", "result_digest", "reviewer_id", "producer_id", "independent", "reviewed_at", "review_result"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
        "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer_id": {"$ref": "#/$defs/id"}, "producer_id": {"$ref": "#/$defs/id"},
        "independent": {"const": true}, "reviewed_at": {"$ref": "#/$defs/time"},
        "review_result": {"type": "object"}
      }
    },
    "adoptionEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "attempt_id", "result_digest", "actor_id", "actor_kind", "actor_role", "authorization_id", "decision", "scope_digest", "decided_at"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
        "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "actor_id": {"$ref": "#/$defs/id"},
        "actor_kind": {"const": "HUMAN"}, "actor_role": {"enum": ["OWNER", "DELEGATED_OPERATOR"]},
        "authorization_id": {"$ref": "#/$defs/id"},
        "decision": {"enum": ["ADOPTED", "PARTIALLY_ADOPTED", "REJECTED", "REVERTED"]},
        "scope_digest": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "decided_at": {"$ref": "#/$defs/time"}
      }
    },
    "priceBasis": {
      "type": "object", "additionalProperties": false,
      "required": ["basis_id", "provider_kind", "model_name", "model_revision", "currency", "input_micros_per_million_tokens", "output_micros_per_million_tokens", "source_ref", "effective_at", "retrieved_at", "comparison_eligible", "missing_reason"],
      "properties": {
        "basis_id": {"$ref": "#/$defs/id"}, "provider_kind": {"$ref": "#/$defs/id"},
        "model_name": {"type": "string", "minLength": 1, "maxLength": 512},
        "model_revision": {"type": "string", "minLength": 1, "maxLength": 512},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "input_micros_per_million_tokens": {"type": "integer", "minimum": 0},
        "output_micros_per_million_tokens": {"type": "integer", "minimum": 0},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "effective_at": {"$ref": "#/$defs/time"}, "retrieved_at": {"$ref": "#/$defs/time"},
        "comparison_eligible": {"type": "boolean"},
        "missing_reason": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]}
      }
    },
    "costEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "attempt_id", "result_digest", "recorded_at", "price_basis", "input_tokens", "output_tokens", "rounding_method", "estimated_cost_micros"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
        "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recorded_at": {"$ref": "#/$defs/time"},
        "price_basis": {"$ref": "#/$defs/priceBasis"},
        "input_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "output_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "rounding_method": {"const": "CEILING_TO_MICRO_UNIT"},
        "estimated_cost_micros": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      }
    },
    "energyEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "attempt_id", "result_digest", "measurement_id", "measurement_evidence_digest", "source_id", "source_kind", "interval_started_at", "interval_finished_at", "observed_energy_kwh", "measurement_scope", "allocation_method", "allocation_ratio", "allocated_energy_kwh", "tariff_basis_id", "tariff_currency", "tariff_micros_per_kwh", "tariff_source_ref", "tariff_effective_at", "tariff_retrieved_at", "energy_cost_micros", "recorded_at"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
        "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "measurement_id": {"$ref": "#/$defs/id"},
        "measurement_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_id": {"$ref": "#/$defs/id"}, "source_kind": {"enum": ["RAPL", "SMART_PLUG", "EXTERNAL_METER"]},
        "interval_started_at": {"$ref": "#/$defs/time"}, "interval_finished_at": {"$ref": "#/$defs/time"},
        "observed_energy_kwh": {"type": "number", "minimum": 0}, "measurement_scope": {"enum": ["TASK", "NODE_INTERVAL", "COMPONENT_INTERVAL"]},
        "allocation_method": {"enum": ["DIRECT", "PROPORTIONAL"]}, "allocation_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "allocated_energy_kwh": {"type": "number", "minimum": 0},
        "tariff_basis_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "tariff_currency": {"anyOf": [{"type": "string", "pattern": "^[A-Z]{3}$"}, {"type": "null"}]},
        "tariff_micros_per_kwh": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "tariff_source_ref": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]},
        "tariff_effective_at": {"$ref": "#/$defs/nullableTime"},
        "tariff_retrieved_at": {"$ref": "#/$defs/nullableTime"},
        "energy_cost_micros": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "recorded_at": {"$ref": "#/$defs/time"}
      }
    },
    "commandMeasurement": {
      "type": "object", "additionalProperties": false,
      "required": ["command_index", "node_id", "boot_id", "worker_started_at_utc", "worker_finished_at_utc",
        "monotonic_started_ns", "monotonic_finished_ns", "execution_duration_ms", "worker_cpu_user_seconds",
        "worker_cpu_system_seconds", "worker_memory_peak_bytes", "measurement_scope", "measurement_method",
        "measurement_completeness", "missing_reasons"],
      "properties": {
        "command_index": {"type": "integer", "minimum": 0, "maximum": 15},
        "node_id": {"$ref": "#/$defs/nodeId"},
        "boot_id": {"anyOf": [{"$ref": "#/$defs/nodeId"}, {"type": "null"}]},
        "worker_started_at_utc": {"$ref": "#/$defs/nullableTime"},
        "worker_finished_at_utc": {"$ref": "#/$defs/nullableTime"},
        "monotonic_started_ns": {"$ref": "#/$defs/nullableIntegerString"},
        "monotonic_finished_ns": {"$ref": "#/$defs/nullableIntegerString"},
        "execution_duration_ms": {"$ref": "#/$defs/nullableNumber"},
        "worker_cpu_user_seconds": {"$ref": "#/$defs/nullableNumber"},
        "worker_cpu_system_seconds": {"$ref": "#/$defs/nullableNumber"},
        "worker_memory_peak_bytes": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "measurement_scope": {"enum": ["DIRECT_CHILD", "DIRECT_CHILD_TREE"]},
        "measurement_method": {"enum": ["RUNNER_LIFECYCLE_ONLY", "GNU_TIME_V1"]},
        "measurement_completeness": {"enum": ["PARTIAL", "COMPLETE"]},
        "missing_reasons": {"$ref": "#/$defs/stringSet"}
      }
    }
  }
}
