{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoduksini:schema:project:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "task_prefix",
    "repository",
    "commands",
    "watch_paths",
    "schema_paths",
    "schema_owner_role",
    "required_gates",
    "harness_paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "task_prefix": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "reference_sha"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^@?#]+$"
        },
        "reference_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "cwd"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "watch_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schema_owner_role": {
      "type": "string",
      "minLength": 1
    },
    "required_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "properties": {
        "LOW": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "MEDIUM": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "HIGH": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "CRITICAL": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "harness_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
