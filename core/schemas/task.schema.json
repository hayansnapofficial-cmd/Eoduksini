{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eoduksini:schema:task:1",
  "title": "Eoduksini task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "milestone",
    "base_sha",
    "owner_role",
    "worktree_id",
    "goal",
    "in_scope_paths",
    "out_of_scope_paths",
    "acceptance_criteria",
    "required_tests",
    "data_risk",
    "schema_change"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$"
    },
    "milestone": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "worktree_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "in_scope_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "out_of_scope_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "required_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "failure_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_considerations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "schema_change": {
      "type": "boolean"
    },
    "shared_file_leases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release_impact": {
      "enum": [
        "NONE",
        "APP_ONLY",
        "DB_COMPATIBLE",
        "DB_CUTOVER",
        "SERVICE_BOUNDARY",
        "INFRA"
      ]
    }
  }
}
