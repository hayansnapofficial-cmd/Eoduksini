{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eoduksini work-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "base_sha",
    "head_sha",
    "files_changed",
    "commands_executed",
    "tests",
    "risks",
    "rollback"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "IMPLEMENTED",
        "BLOCKED",
        "NEEDS_FIX",
        "REPOSITORY_DRIFT",
        "SCHEMA_LEASE_CONFLICT"
      ]
    },
    "base_sha": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_executed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 3
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "urn:eoduksini:schema:work-result:1"
}
