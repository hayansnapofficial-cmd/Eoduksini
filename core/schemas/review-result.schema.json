{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eoduksini review-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "reviewer_role",
    "verdict",
    "findings",
    "evidence"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "reviewer_role": {
      "enum": [
        "reviewer",
        "security-reviewer",
        "critic",
        "auditor"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "NEEDS_FIX",
        "REJECT",
        "BLOCKED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "summary",
          "evidence"
        ],
        "properties": {
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "required_change": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "independent_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "urn:eoduksini:schema:review-result:1"
}
